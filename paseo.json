{
  "worktree": {
    "setup": [
      "python3.12 -m venv .venv",
      ".venv/bin/python -m pip install -r requirements-contracts.txt",
      "./gradlew --no-daemon --dependency-verification=strict :core:dependencies"
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "test": {
      "command": "./gradlew --no-daemon --dependency-verification=strict :core:check"
    }
  }
}
