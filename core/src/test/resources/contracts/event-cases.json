{
  "profile": "android-frozen-event-wire/v1",
  "schema_sha256": "e169ad8d2f7417580ef63a5098f8ec54dd514af3ce609c59bdb7780b89d6039a",
  "example_sha256": "ed0a9e96da773bc74bceb774f576971275f6da525fa9b425c3b8d6e5f7406068",
  "cases": [
    {
      "name": "canonical synthetic event",
      "expected": "decoded"
    },
    {
      "name": "required payload may be empty",
      "expected": "decoded",
      "set": {
        "payload": {}
      }
    },
    {
      "name": "all optional fields retain supplied values",
      "expected": "decoded",
      "set": {
        "subject_version": "any version text",
        "causation_id": "cause.fixture"
      },
      "payload_set": {
        "catalog_item_id": "catalog.item.fixture",
        "evaluation_report_id": "report.fixture",
        "cost_estimate_id": "cost.fixture",
        "note": "synthetic-private-event"
      }
    },
    {
      "name": "optional empty strings and affected kinds remain present",
      "expected": "decoded",
      "set": {
        "subject_version": "",
        "causation_id": ""
      },
      "payload_set": {
        "note": "",
        "affected_kinds": []
      }
    },
    {
      "name": "event subject and payload have no added semantic coupling",
      "expected": "decoded",
      "set": {
        "type": "pricebook.published",
        "subject_type": "catalog_item"
      }
    },
    {
      "name": "opaque references use length only",
      "expected": "decoded",
      "set": {
        "actor_ref": " ",
        "correlation_id": "\t",
        "idempotency_key": "\n"
      }
    },
    {
      "name": "timestamp retains offset spelling",
      "expected": "decoded",
      "set": {
        "occurred_at": "2026-10-16T10:30:00+01:30"
      }
    },
    {
      "name": "terminal LF keeps frozen identifier behavior",
      "expected": "decoded",
      "set": {
        "id": "evt.fixture.1\n",
        "subject_id": "build.fixture.1\n"
      },
      "payload_set": {
        "selection_id": "sel_model\n",
        "catalog_item_id": "catalog.fixture\n"
      }
    },
    {
      "name": "event type build.created",
      "expected": "decoded",
      "set": {
        "type": "build.created"
      }
    },
    {
      "name": "event type build.selection.upserted",
      "expected": "decoded",
      "set": {
        "type": "build.selection.upserted"
      }
    },
    {
