<resources>
    <style name="PreviewTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/PreviewAlertDialogTheme</item>
    </style>
    <style name="PreviewAlertDialogTheme" parent="android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>
</resources>
